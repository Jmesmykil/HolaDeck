diff --git a/port/linux/launch_halo.sh b/port/linux/launch_halo.sh
new file mode 100755
index 0000000..052b2ac
--- /dev/null
+++ b/port/linux/launch_halo.sh
@@ -0,0 +1,13 @@
+#!/bin/bash
+# Starts the game from the folder this script is in (through any symbolic
+# link to it), as a Steam Deck install keeps it (README_DECK.md): halo, the
+# 32-bit libSDL3.so.0 (here or in lib/) and the game data (maps/ or
+# assets/maps/). The game starts fullscreen and turns on Mesa's GL thread by
+# itself; config.toml or a Steam launch option such as
+# `HALO_FULLSCREEN=false %command%` changes that.
+DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
+cd "$DIR" || exit 1
+
+export LD_LIBRARY_PATH="$DIR/lib:$DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+
+exec ./halo "$@"
