 """Tests for the native Linux build tooling (port/linux, tools/linux_*.py)."""
 
+import json
 import re
 import shutil
 import subprocess
@@ -224,3 +225,30 @@ def test_build_graph_without_port_has_no_linux_target(tmp_path, monkeypatch):
     ninja = Path("build.ninja").read_text(encoding="utf-8")
     assert "linux_cc" not in ninja
     assert "build linux:" not in ninja
+
+
+def test_link_takes_library_directories_and_keeps_origin_in_the_run_path(tmp_path, monkeypatch):
+    write(tmp_path / "port" / "linux" / "port.json", json.dumps({
+        "projects": ["halobetacache"],
+        "platform_sources": "port/linux/src",
+        "game_sources": "port/linux/game",
+        "libraries": ["SDL3", "m"],
+        "runpath": ["$ORIGIN/lib", "$ORIGIN"],
+    }))
+    sln = make_solution(tmp_path, monkeypatch, linux_lib_dirs=[Path("lib32/usr/lib32")], port_pgo="off")
+    generate_build_ninja(sln)
+    ninja = re.sub(r"\$\n\s+", "", Path("build.ninja").read_text(encoding="utf-8"))
+    libs = re.findall(r"^  libs = (.*)$", ninja, re.M)
+    assert libs == ["-Llib32/usr/lib32 -lSDL3 -lm -Wl,-rpath,'$$ORIGIN/lib:$$ORIGIN'"]
+    if shutil.which("ninja") is None:
+        pytest.skip("ninja is needed to expand the link command")
+    # what the linker is given once ninja and then the shell have read it:
+    # neither may expand $ORIGIN, which the loader replaces with the
+    # executable's directory
+    show = tmp_path / "show.ninja"
+    show.write_text(f"rule show\n  command = printf '%s\\n' $libs > $out\n"
+                    f"build shown.txt: show\n  libs = {libs[0]}\n", encoding="utf-8")
+    subprocess.run(["ninja", "-f", str(show)], cwd=tmp_path, check=True, capture_output=True)
+    assert (tmp_path / "shown.txt").read_text().split() == [
+        "-Llib32/usr/lib32", "-lSDL3", "-lm", "-Wl,-rpath,$ORIGIN/lib:$ORIGIN",
+    ]
