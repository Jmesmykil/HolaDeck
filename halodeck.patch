@@ -223,6 +223,17 @@ def _quote(path: Any) -> str:
     return f'"{text}"' if " " in text else text
 
 
+def runpath_flags(directories: Sequence[str]) -> List[str]:
+    """The linker flag giving the executable its run path, the directories
+    the loader searches for its libraries before the system's (port.json's
+    "runpath"; $ORIGIN is the executable's own directory, so a libSDL3.so.0
+    copied next to it is found). Quoted so that the shell leaves $ORIGIN
+    alone, and escaped so that ninja does."""
+    if not directories:
+        return []
+    return [escape(f"-Wl,-rpath,'{':'.join(directories)}'")]
+
+
 def generate_linux_build(n: Writer, sln: Any) -> None:
